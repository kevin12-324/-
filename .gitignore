# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get quite large and must be ignored
/[Mm]emoryCaptures/

# Recordings can get quite large and must be ignored
/[Rr]ecordings/

# Uncomment this if you have LFS enabled for all files
# *.* filter=lfs diff=lfs merge=lfs -text

# Uncomment this if you have LFS enabled for some files
# *.unitypackage filter=lfs diff=lfs merge=lfs -text

# .NET
*.csproj
*.sln

# Jetbrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/
*.code-workspace

# Visuals Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD5 caches/packages, can be used to recover lost code
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Crashes
crash.dump
crash.dump.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
